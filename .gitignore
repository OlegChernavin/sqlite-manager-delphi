# Build output (project uses .\$(Platform)\$(Config))
Win32/
Win64/
bin/
dcu/
lib/
obj/

# Delphi history / backups
__history/
__recovery/

# User / machine settings
*.ini
!docs/*.ini

# IDE
*.dproj.local
*.groupproj.local
*.stat

# VS Code / Cursor (local only; skills stay tracked if already committed)
