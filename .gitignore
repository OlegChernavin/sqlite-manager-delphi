.cursor/*
!.cursor/skills/

# OS
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
.DS_Store

# Installer output (script installer.iss is tracked)
installer/*.exe

# Logs and temp
*.log
*.tmp
*.temp

# Secrets (AI keys etc.)
*.secret
.env
.env.*
